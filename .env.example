# Copy this file to .env and edit the values.
SECRET_KEY=replace-this-with-a-long-random-string
ADMIN_PASSWORD=admin123
ALLOWED_ORIGINS=*
TOKEN_HOURS=12
# Optional. Without a key the app uses the seeded dataset (YouTube search links).
# With a key, admins can fetch real, captioned, embeddable videos for each topic.
YOUTUBE_API_KEY=
# Frontend only: where the backend is running
API_URL=http://127.0.0.1:8000
